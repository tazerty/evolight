<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>EvoLight</string>
  <key>CFBundleName</key>
  <string>EvoLight</string>
  <key>CFBundleExecutable</key>
  <string>EvoLight</string>
  <key>CFBundleIdentifier</key>
  <string>ai.storyteller.evolight</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>EvoLightVersion</key>
  <string>@VERSION@</string>
  <key>EvoLightBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>EvoLight</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.graphics-design</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <!-- Shown by macOS when EvoLight first asks to control Photos (Export > Add to Apple Photos;
       needs the apple-events entitlement in entitlements.plist). -->
  <key>NSAppleEventsUsageDescription</key>
  <string>EvoLight asks Photos to import the photos you export when you choose Add to Apple Photos in the Export dialog.</string>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the EvoLight authors. MIT OR Apache-2.0.</string>

  <!-- No UTI declarations: EvoLight has no document type of its own, and the formats it opens
       (JPEG, PNG, TIFF, HEIC, the raw formats) are declared by the system or by another app.
       Declaring EvoPhoto's `.evophoto` type here (and importing PSB and QOI) made Launch Services
       type EvoPhoto documents as EvoLight's; `.evophoto` ended up with three claimant apps
       (issue #1951). -->

</dict>
</plist>
